generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum CustomFieldType {
  TEXT
  NUMBER
  SINGLE_SELECT
  DATE
}

enum IntakeFormFieldType {
  TITLE
  DESCRIPTION
  TEXT
  NUMBER
  SINGLE_SELECT
  DATE
}

enum AutomationTrigger {
  TASK_CREATED
  STATUS_CHANGED
}

enum AutomationAction {
  SET_STATUS
  SET_ASSIGNEE
  ADD_COMMENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships        WorkspaceMember[]
  createdInvites     WorkspaceInvite[] @relation("InviteCreator")
  createdProjects    Project[]         @relation("ProjectCreator")
  createdTasks       Task[]            @relation("TaskCreator")
  assignedTasks      Task[]            @relation("TaskAssignee")
  comments           Comment[]
  commentMentions    CommentMention[]
  activityEvents     ActivityEvent[]
  notifications      Notification[]
  actorNotifications Notification[] @relation("NotificationActor")
  attachments        TaskAttachment[]
  createdIntakeForms IntakeForm[]      @relation("IntakeFormCreator")
  defaultAssigneeForms IntakeForm[]    @relation("IntakeFormDefaultAssignee")
  automationAssignees AutomationRule[] @relation("AutomationAssignee")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       WorkspaceMember[]
  invites       WorkspaceInvite[]
  roles         WorkspaceRole[]
  projects      Project[]
  customFields  CustomFieldDefinition[]
  notifications Notification[]
  intakeForms   IntakeForm[]
  automations   AutomationRule[]
}

model WorkspaceRole {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  key         String
  isSystem    Boolean  @default(false)
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   WorkspaceMember[]
  invites   WorkspaceInvite[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  roleId      String
  createdAt   DateTime @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      WorkspaceRole @relation(fields: [roleId], references: [id])

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([roleId])
}

model WorkspaceInvite {
  id          String       @id @default(cuid())
  workspaceId String
  email       String
  token       String       @unique
  roleId      String
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  createdById String
  createdAt   DateTime     @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User          @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  role      WorkspaceRole @relation(fields: [roleId], references: [id])

  @@index([workspaceId, email])
  @@index([token])
  @@index([roleId])
}

model Project {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  brief       String?
  archivedAt  DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("ProjectCreator", fields: [createdById], references: [id])
  tasks       Task[]
  sections    ProjectSection[]
  intakeForms IntakeForm[]
  automations AutomationRule[]

  @@index([workspaceId])
}

model ProjectSection {
  id        String   @id @default(cuid())
  projectId String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, position])
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  sectionId   String?
  parentId    String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(NONE)
  dueDate     DateTime?
  startDate   DateTime?
  assigneeId  String?
  createdById String
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section      ProjectSection?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parent       Task?               @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks     Task[]              @relation("Subtasks")
  assignee     User?               @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User                @relation("TaskCreator", fields: [createdById], references: [id])
  comments     Comment[]
  activity     ActivityEvent[]
  fieldValues  CustomFieldValue[]
  notifications Notification[]
  blockedBy     TaskDependency[] @relation("BlockedTask")
  blocking      TaskDependency[] @relation("BlockingTask")
  attachments   TaskAttachment[]

  @@index([projectId, status])
  @@index([projectId, sectionId])
  @@index([assigneeId])
  @@index([parentId])
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  uploadedById String
  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskDependency {
  id          String   @id @default(cuid())
  taskId      String
  dependsOnId String
  createdAt   DateTime @default(now())

  task      Task @relation("BlockedTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("BlockingTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([dependsOnId])
}

model CustomFieldDefinition {
  id          String          @id @default(cuid())
  workspaceId String
  name        String
  type        CustomFieldType
  options     Json?
  position    Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values          CustomFieldValue[]
  intakeFormFields IntakeFormField[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model CustomFieldValue {
  id          String    @id @default(cuid())
  fieldId     String
  taskId      String
  textValue   String?
  numberValue Float?
  dateValue   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  field CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  task  Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([fieldId, taskId])
  @@index([taskId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task     Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author   User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mentions CommentMention[]

  @@index([taskId])
}

model CommentMention {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
}

model ActivityEvent {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String
  type      String
  meta      Json?
  createdAt DateTime @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENTED
  STATUS_CHANGED
  DUE_SOON
  MENTIONED
}

model Notification {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  actorId     String?
  taskId      String?
  type        NotificationType
  title       String
  body        String?
  meta        Json?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId, createdAt])
  @@index([userId, readAt])
}

model IntakeForm {
  id                 String      @id @default(cuid())
  workspaceId        String
  projectId          String
  name               String
  description        String?
  token              String      @unique
  isActive           Boolean     @default(true)
  createdById        String
  defaultAssigneeId  String?
  defaultStatus      TaskStatus  @default(TODO)
  titleTemplate      String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User              @relation("IntakeFormCreator", fields: [createdById], references: [id])
  defaultAssignee User?             @relation("IntakeFormDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  fields          IntakeFormField[]

  @@index([workspaceId])
  @@index([token])
}

model IntakeFormField {
  id            String              @id @default(cuid())
  formId        String
  key           String
  label         String
  type          IntakeFormFieldType
  required      Boolean             @default(false)
  options       Json?
  customFieldId String?
  position      Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  form        IntakeForm             @relation(fields: [formId], references: [id], onDelete: Cascade)
  customField CustomFieldDefinition? @relation(fields: [customFieldId], references: [id], onDelete: SetNull)

  @@unique([formId, key])
  @@index([formId])
}

model AutomationRule {
  id                String            @id @default(cuid())
  workspaceId       String
  projectId         String?
  name              String
  isActive          Boolean           @default(true)
  trigger           AutomationTrigger
  triggerFromStatus TaskStatus?
  triggerToStatus   TaskStatus?
  action            AutomationAction
  actionStatus      TaskStatus?
  actionAssigneeId  String?
  actionComment     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actionAssignee User?     @relation("AutomationAssignee", fields: [actionAssigneeId], references: [id], onDelete: SetNull)

  @@index([workspaceId, isActive])
  @@index([projectId])
}
