# Copy to apps/api/.env for local API
DATABASE_URL="postgresql://asanop:asanop@localhost:5434/asanop?schema=public"
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=3000
WEB_ORIGIN="http://localhost:5173"

# Dedicated automated-test database. Tests refuse URLs that do not contain asanop_test.
TEST_DATABASE_URL="postgresql://asanop:asanop@localhost:5434/asanop_test?schema=public"

# --- Production (Render API) ---
# DATABASE_URL = Render Postgres Internal Database URL
# JWT_SECRET   = long random string
# WEB_ORIGIN   = https://YOUR-APP.vercel.app   (exact Vercel URL, no trailing slash)
# PORT         = set automatically by Render

# --- Production (Vercel web) ---
# In Vercel project → Settings → Environment Variables:
# VITE_API_URL = https://YOUR-API.onrender.com/api
